{
  "name": "harmonized-vscode-theme",
  "displayName": "Harmonized",
  "type": "module",
  "description": "Solarized light and dark themes, refined: more readable text, light and dark that match, plus high-contrast and accented variants.",
  "version": "0.8.7",
  "scripts": {
    "release:major": "npx @vscode/vsce publish major && git push --follow-tags",
    "release:minor": "npx @vscode/vsce publish minor && git push --follow-tags",
    "release:patch": "npx @vscode/vsce publish patch && git push --follow-tags",
    "build": "node src/index.js && node src/check.js",
    "update-solarized": "node src/update-solarized.js"
  },
  "preview": false,
  "publisher": "wheredoesyourmindgo",
  "galleryBanner": {
    "color": "#fdf6e3",
    "theme": "light"
  },
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/wheredoesyourmindgo/harmonized-vscode-theme"
  },
  "bugs": {
    "url": "https://github.com/wheredoesyourmindgo/harmonized-vscode-theme/issues"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "solarized",
    "solarized light",
    "solarized dark",
    "light",
    "dark",
    "high contrast",
    "readability"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Harmonized light",
        "uiTheme": "vs",
        "path": "./themes/light.json"
      },
      {
        "label": "Harmonized dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dark.json"
      },
      {
        "label": "Harmonized light _",
        "uiTheme": "vs",
        "path": "./themes/light_.json"
      },
      {
        "label": "Harmonized dark _",
        "uiTheme": "vs-dark",
        "path": "./themes/dark_.json"
      },
      {
        "label": "Harmonized light (hc)",
        "uiTheme": "vs",
        "path": "./themes/light-hc.json"
      },
      {
        "label": "Harmonized dark (hc)",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-hc.json"
      },
      {
        "label": "Harmonized light (hc) _",
        "uiTheme": "vs",
        "path": "./themes/light-hc_.json"
      },
      {
        "label": "Harmonized dark (hc) _",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-hc_.json"
      }
    ]
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "devDependencies": {
    "@types/vscode": "1.106.1",
    "json5": "^2.2.3"
  },
  "vsce": {
    "dependencies": false
  }
}
